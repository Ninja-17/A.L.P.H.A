<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A.L.P.H.A."
            android:textColor="#00FF00"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autonomous Learning Proactive Heuristic Agent"
            android:textColor="#00AA00"
            android:textSize="12sp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:background="#111111"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="1. Configurar Accesibilidad"
            android:background="#1a6b1a"
            android:textColor="#00FF00"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="2. Permitir Overlay"
            android:background="#1a6b1a"
            android:textColor="#00FF00"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="3. Activar Notificaciones"
            android:background="#1a6b1a"
            android:textColor="#00FF00"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="4. Desactivar Optimización Batería"
            android:background="#1a6b1a"
            android:textColor="#00FF00"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="▶ INICIAR A.L.P.H.A."
            android:background="#00AA00"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
