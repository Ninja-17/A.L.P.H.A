{
  "$schema": "https://opencode.ai/config.json",
  "username": "Ninja-17",
  "model": "openrouter/google/gemini-3.5-flash",
  "plugin": [
    "@sami7786/opencode-image-proxy@latest"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "google/gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "free": {
          "name": "OpenRouter Free Router",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
